#!/usr/bin/env node

'use strict';

process.title = 'portal';

var semver = require('semver');

if (!semver.satisfies(process.version, '>=7')) {
  console.log('portal requires Node 7+');
  process.exit(1);
}

const portal = require('../build/portal.js').portal;
const portal = new portal();
portal.initialize();

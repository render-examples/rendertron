{
  "name": "portal-middleware",
  "version": "0.1.5",
  "description": "Express middleware for the portal service.",
  "engines": {
    "node": "20.10.0"
  },
  "main": "build/middleware.js",
  "types": "build/middleware.d.ts",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "lint": "tslint --project . --format stylish",
    "format": "find src -name '*.ts' | xargs clang-format --style=file -i",
    "test": "npm run build && ava 'build/**/*-test.js'"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@types/express": "^4.17.21",
    "request": "^2.88.2"
  },
  "devDependencies": {
    "@types/request": "^2.47.1",
    "@types/supertest": "^2.0.5",
    "ava": "^6.1.3",
    "clang-format": "^1.2.4",
    "express": "^4.16.3",
    "supertest": "^3.0.0",
    "tslint": "^6.1.3",
    "typescript": "^4.5.0"
  }
}

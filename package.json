{
  "name": "portal",
  "version": "3.0.1",
  "description": "Renders webpages using headless Chrome for usage by bots based of portal",
  "license": "Apache-2.0",
  "repository": "https://github.com/turnout-labs/portal",
  "engines": {
    "node": "^20.10.0"
  },
  "main": "build/portal.js",
  "types": "build/portal.d.ts",
  "bin": "bin/portal.js",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node build/portal.js",
    "format": "find *.ts | xargs clang-format --style=file -i",
    "lint": "tslint --project . --format stylish",
    "monitor": "nodemon",
    "monitor-inspect": "nodemon --inspect src/main.js",
    "test": "(cd test-resources && npm install) && npm run build && ava build/test/app-test.js --timeout 5s",
    "start-emulator": "(gcloud beta emulators datastore start --no-store-on-disk --project emulator-project &) 2>&1 | grep -m1 'now running'",
    "test-cache": "npm run start-emulator && $(gcloud beta emulators datastore env-init) && export GCLOUD_PROJECT='emulator-project' && ava build/test/datastore-cache-test.js"
  },
  "dependencies": {
    "@google-cloud/datastore": "^8.7.0",
    "@types/fs-extra": "^5.1.0",
    "@webcomponents/webcomponentsjs": "^1.3.3",
    "chrome-launcher": "^1.1.1",
    "chrome-remote-interface": "^0.26.1",
    "emver": "^0.8.0",
    "fs-extra": "^7.0.1",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^3.1.0",
    "koa-logger": "^3.2.1",
    "koa-route": "^3.2.0",
    "koa-send": "^5.0.0",
    "koa-static": "^5.0.0",
    "performance-now": "^2.1.0",
    "progress-bar-element": "^2.0.1",
    "puppeteer": "^22.9.0",
    "semver": "^7.6.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/google-cloud__datastore": "^1.3.3",
    "@types/koa": "^2.0.46",
    "@types/koa-bodyparser": "^5.0.1",
    "@types/koa-compress": "^2.0.8",
    "@types/koa-logger": "^3.1.1",
    "@types/koa-route": "^3.2.4",
    "@types/koa-send": "^4.1.1",
    "@types/koa-static": "^4.0.0",
    "@types/puppeteer": "^1.6.0",
    "@types/supertest": "^2.0.4",
    "ava": "^6.1.3",
    "nodemon": "^3.1.0",
    "resolve-tspaths": "^0.8.19",
    "supertest": "^3.0.0",
    "ts-lint": "^4.5.1",
    "typescript": "^4.5.0"
  }
}
